# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Airflow runtime — keep the empty logs/ dir itself (needed for the
# docker-compose bind mount) but not what gets written into it
logs/*
!logs/.gitkeep
airflow.cfg
airflow-webserver.pid

# Markdown notes/planning docs, not part of the shipped repo
*.md
!README.md

.claude