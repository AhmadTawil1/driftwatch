# Postgres (used by the Airflow containers, via the internal Docker network)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# This project's own database — a second database in the same Postgres
# instance, kept separate from Airflow's metadata db. Used by Alembic,
# seed.py, and the app code, run from the host, hence "localhost" rather
# than the container network hostname above.
WATCHDOG_DATABASE_URL=

# Provider credentials (names referenced by rows in the `providers` table —
# never store the key values themselves in the database)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alerting
SLACK_WEBHOOK_URL=

# Cost controls
NIGHTLY_COST_CAP_USD=

# Airflow (3.x — the UI/API process is "api-server", not "webserver";
# it authenticates internal traffic with a JWT rather than a secret key)
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=
