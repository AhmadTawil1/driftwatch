# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Provider credentials (names referenced by rows in the `providers` table —
# never store the key values themselves in the database)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alerting
SLACK_WEBHOOK_URL=

# Cost controls
NIGHTLY_COST_CAP_USD=

# Airflow (3.x — the UI/API process is "api-server", not "webserver";
# it authenticates internal traffic with a JWT rather than a secret key)
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=
